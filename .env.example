# Local vision and Astra through a signed-in Codex CLI need no API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
# Optional executable path; auto-detects working PATH and desktop bundled Codex.
SFC_CODEX_BIN=
# Optional targeted, sanitized CLI network diagnostics. Does not log prompts or image data.
SFC_CODEX_DEBUG=0
# Optional absolute Workbench .data directory (containing runs/ and clips/).
SFC_WORKBENCH_DATA=
# Optional absolute path; defaults to this project's .data/.
SFC_DATA_DIR=
